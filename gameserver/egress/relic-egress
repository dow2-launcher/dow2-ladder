#!/usr/bin/env python3
"""relic-egress - the DWR3 bridge's TCP to Relic relays leaves a Moscow node through iggy, not from Russia.

Two ways to iggy, first that works:
  du    du-egress (127.0.0.1:12349): our UDP tunnel (DU) to udp_gateway on iggy, iggy's battle_relay bridges to Relic;
        check: du-egress active and a DU PING to iggy:47100 answered
  vless xray-relic (127.0.0.1:12347): VLESS gRPC REALITY to iggy, Relic is opened from there;
        check: xray-relic active and "DWRQ" + sid through 127.0.0.1:12348 -> iggy's battle_relay answers Y/N
  none  no rule: bridges go straight to Relic as before

  relic-egress watch        loop (relic-egress.service): every CHECK s; a way counts as down after FAILS failed checks in a
                            row; the rule always carries the uid dow2-battle runs as now (DynamicUser, may change on a restart)
  relic-egress down [port]  remove the rule (only if it points to that port, when given) - ExecStopPost of the services
  relic-egress status       the rule, the checks, the uid

Rule (nat OUTPUT, only new connections; open bridges are never touched):
  -A OUTPUT -p tcp -j RELIC_EGRESS
  -A RELIC_EGRESS -p tcp --dport 27000:27099 -m owner --uid-owner <dow2-battle uid> -j REDIRECT --to-ports 12347
"""
import os, socket, subprocess, sys, time

CHAIN, PORT, CHECK_PORT, DU_PORT, GW = 'RELIC_EGRESS', 12347, 12348, 12349, ('116.202.106.150', 47100)
CHECK, FAILS = 10, 3


def ipt(*a, check=False):
    return subprocess.run(['iptables', '-w', '-t', 'nat', *a], capture_output=True, text=True).returncode == 0 if check else \
        subprocess.run(['iptables', '-w', '-t', 'nat', *a], capture_output=True, text=True)


def active(unit):
    return subprocess.run(['systemctl', 'is-active', '--quiet', unit]).returncode == 0


def battle_uid():
    pid = subprocess.run(['systemctl', 'show', '-p', 'MainPID', '--value', 'dow2-battle'], capture_output=True, text=True).stdout.strip()
    try:
        for line in open(f'/proc/{pid}/status'):
            if line.startswith('Uid:'): return int(line.split()[1])
    except Exception: return None


def tunnel_ok():
    try:
        s = socket.create_connection(('127.0.0.1', CHECK_PORT), 3); s.settimeout(5)
        s.sendall(b'DWRQ' + os.urandom(4)); a = s.recv(1); s.close()
        return a in (b'Y', b'N')
    except Exception: return False


def du_ok():
    try:
        u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); u.settimeout(2); cid = os.urandom(4)
        for _ in range(2):
            u.sendto(b'DU\x06' + cid + b'chk', GW)
            try:
                d = u.recv(64)
                if d[:3] == b'DU\x07' and d[3:7] == cid: return True
            except socket.timeout: pass
    except Exception: pass
    return False


def rule(uid, port):
    return ['-p', 'tcp', '--dport', '27000:27099', '-m', 'owner', '--uid-owner', str(uid), '-j', 'REDIRECT', '--to-ports', str(port)]


def current():
    out = ipt('-S', CHAIN).stdout if ipt('-S', CHAIN, check=True) else ''
    return [l for l in out.splitlines() if l.startswith('-A ')]


def up(uid, port, name):
    if not ipt('-S', CHAIN, check=True): ipt('-N', CHAIN)
    want = rule(uid, port)
    if not ipt('-C', CHAIN, *want, check=True) or len(current()) != 1:
        ipt('-F', CHAIN); ipt('-A', CHAIN, *want); log(f'rule up: uid {uid} 27000-27099 -> :{port} ({name} via iggy)')
    if not ipt('-C', 'OUTPUT', '-p', 'tcp', '-j', CHAIN, check=True): ipt('-A', 'OUTPUT', '-p', 'tcp', '-j', CHAIN)


def down(why=''):
    had = bool(current())
    while ipt('-C', 'OUTPUT', '-p', 'tcp', '-j', CHAIN, check=True): ipt('-D', 'OUTPUT', '-p', 'tcp', '-j', CHAIN)
    if ipt('-S', CHAIN, check=True): ipt('-F', CHAIN); ipt('-X', CHAIN)
    if had: log(f'rule down{": " + why if why else ""} (bridges go straight to Relic)')


def log(m): print(m, flush=True)


def watch():
    bad = {'du': FAILS, 'vless': FAILS}           # each way "down" until its first good check
    ways = [('du', 'du-egress', du_ok, DU_PORT), ('vless', 'xray-relic', tunnel_ok, PORT)]
    while True:
        uid = battle_uid()
        for name, unit, ok, port in ways:
            if not active(unit): bad[name] = FAILS
            else: bad[name] = 0 if ok() else bad[name] + 1
        pick = next(((n, p) for n, u, o, p in ways if bad[n] < FAILS), None)
        if uid is not None and pick: up(uid, pick[1], pick[0])
        else: down('no way to iggy works' if uid is not None else 'dow2-battle not running')
        time.sleep(CHECK)


if __name__ == '__main__':
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'status'
    if cmd == 'watch': watch()
    elif cmd == 'down':
        port = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2].isdigit() else None
        if port is None or any(f'--to-ports {port}' in l for l in current()): down(' '.join(sys.argv[2:]))
    else: print('\n'.join(current()) or 'no rule', '| du', 'ok' if du_ok() else 'FAIL', '| vless', 'ok' if tunnel_ok() else 'FAIL',
                '| battle uid', battle_uid())
