#!/usr/bin/env python3
"""relic-egress - the DWR3 bridge's TCP to Relic relays leaves a Moscow node through iggy (xray-relic), not from Russia.

  relic-egress watch   loop (relic-egress.service): every CHECK s - xray-relic active, the tunnel answers end to end
                       (127.0.0.1:12348 -> VLESS -> iggy's battle_relay "DWRQ" -> Y/N) and dow2-battle runs -> the rule is
                       there (with the uid dow2-battle runs as now: DynamicUser, it may change on a restart); FAILS checks in
                       a row failed -> the rule goes (new bridges go straight to Relic as before, nothing breaks).
  relic-egress down    remove the rule (xray-relic ExecStopPost, relic-egress.service ExecStopPost)
  relic-egress status  print the rule and a check

Rule (nat OUTPUT, only new connections; open bridges are never touched):
  -A OUTPUT -p tcp -j RELIC_EGRESS
  -A RELIC_EGRESS -p tcp --dport 27000:27099 -m owner --uid-owner <dow2-battle uid> -j REDIRECT --to-ports 12347
"""
import os, socket, subprocess, sys, time

CHAIN, PORT, CHECK_PORT = 'RELIC_EGRESS', 12347, 12348
CHECK, FAILS = 10, 3


def ipt(*a, check=False):
    return subprocess.run(['iptables', '-w', '-t', 'nat', *a], capture_output=True, text=True).returncode == 0 if check else \
        subprocess.run(['iptables', '-w', '-t', 'nat', *a], capture_output=True, text=True)


def active(unit):
    return subprocess.run(['systemctl', 'is-active', '--quiet', unit]).returncode == 0


def battle_uid():
    pid = subprocess.run(['systemctl', 'show', '-p', 'MainPID', '--value', 'dow2-battle'], capture_output=True, text=True).stdout.strip()
    try:
        for line in open(f'/proc/{pid}/status'):
            if line.startswith('Uid:'): return int(line.split()[1])
    except Exception: return None


def tunnel_ok():
    try:
        s = socket.create_connection(('127.0.0.1', CHECK_PORT), 3); s.settimeout(5)
        s.sendall(b'DWRQ' + os.urandom(4)); a = s.recv(1); s.close()
        return a in (b'Y', b'N')
    except Exception: return False


def rule(uid):
    return ['-p', 'tcp', '--dport', '27000:27099', '-m', 'owner', '--uid-owner', str(uid), '-j', 'REDIRECT', '--to-ports', str(PORT)]


def current():
    out = ipt('-S', CHAIN).stdout if ipt('-S', CHAIN, check=True) else ''
    return [l for l in out.splitlines() if l.startswith('-A ')]


def up(uid):
    if not ipt('-S', CHAIN, check=True): ipt('-N', CHAIN)
    want = rule(uid)
    if not ipt('-C', CHAIN, *want, check=True):
        ipt('-F', CHAIN); ipt('-A', CHAIN, *want); log(f'rule up: uid {uid} 27000-27099 -> :{PORT} (via iggy)')
    if not ipt('-C', 'OUTPUT', '-p', 'tcp', '-j', CHAIN, check=True): ipt('-A', 'OUTPUT', '-p', 'tcp', '-j', CHAIN)


def down(why=''):
    had = bool(current())
    while ipt('-C', 'OUTPUT', '-p', 'tcp', '-j', CHAIN, check=True): ipt('-D', 'OUTPUT', '-p', 'tcp', '-j', CHAIN)
    if ipt('-S', CHAIN, check=True): ipt('-F', CHAIN); ipt('-X', CHAIN)
    if had: log(f'rule down{": " + why if why else ""} (bridges go straight to Relic)')


def log(m): print(m, flush=True)


def watch():
    bad = FAILS                                   # start as "down" until the first good check
    while True:
        uid = battle_uid() if active('xray-relic') else None
        ok = uid is not None and tunnel_ok()
        bad = 0 if ok else bad + 1
        if ok: up(uid)
        elif bad >= FAILS or not active('xray-relic'): down('xray-relic inactive' if not active('xray-relic') else f'{bad} checks failed')
        time.sleep(CHECK)


if __name__ == '__main__':
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'status'
    if cmd == 'watch': watch()
    elif cmd == 'down': down(' '.join(sys.argv[2:]))
    else: print('\n'.join(current()) or 'no rule', '| tunnel', 'ok' if tunnel_ok() else 'FAIL', '| battle uid', battle_uid())
